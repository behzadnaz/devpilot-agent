        <button class="environment-filter" type="button" data-filter="installed">Installed</button>
        <button class="environment-filter" type="button" data-filter="mismatch">Mismatched</button>
        <button class="environment-filter" type="button" data-filter="missing">Missing</button>
        <button class="environment-filter" type="button" data-filter="unchecked">Not checked</button>
      </div>

      <div class="environment-list">
        <article class="environment-item" data-status="installed">
          <div class="environment-item-head">
            <div class="technology-mark">Py</div>
            <div class="technology-info">
              <strong>Python</strong>
              <small>Backend runtime</small>
            </div>
            <span class="status-pill installed">Installed</span>
          </div>
          <div class="version-grid">
            <div><small>Installed version</small><strong>3.12.4</strong></div>
            <div><small>Target version</small><strong>3.12</strong></div>
          </div>
          <details class="environment-details">
            <summary>Version and installation details</summary>
            <p>Illustrative result: the detected version meets the target requirement.</p>
          </details>
        </article>

        <article class="environment-item" data-status="mismatch">
          <div class="environment-item-head">
            <div class="technology-mark">JS</div>
            <div class="technology-info">
              <strong>Node.js</strong>
              <small>Frontend runtime</small>
            </div>
            <span class="status-pill mismatch">Version mismatch</span>
          </div>
          <div class="version-grid">
            <div><small>Installed version</small><strong>20.15.1</strong></div>
            <div><small>Target version</small><strong>22 LTS</strong></div>
          </div>
          <details class="environment-details">
            <summary>Version and installation details</summary>
            <p>Illustrative result: review compatibility and the proposed upgrade before making changes.</p>
            <div class="proposed-action">
              <strong>Proposed action</strong>
              <p>Review the target release, package source, upgrade commands and impact before confirmation.</p>
