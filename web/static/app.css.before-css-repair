          <span>Mismatched</span>
          <strong id="countMismatch">1</strong>
        </div>
        <div class="environment-stat">
          <span class="status-dot missing"></span>
          <span>Not installed</span>
          <strong id="countMissing">1</strong>
        </div>
        <div class="environment-stat">
          <span class="status-dot unchecked"></span>
          <span>Not checked</span>
          <strong id="countUnchecked">0</strong>
