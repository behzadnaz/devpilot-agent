        <svg class="icon"><use href="#i-arrowleft"></use></svg>
        Back
      </button>
      <span id="wizardProgress" class="muted">Step 1 of 5</span>
      <button id="wizardNext" type="button">
        Next
        <svg class="icon"><use href="#i-arrowright"></use></svg>
      </button>
      <button id="dialogCreate" type="button" hidden>
        <svg class="icon"><use href="#i-check"></use></svg>
        Create project
      </button>
    </div>
  </footer>
</dialog>
  </main>

  <!-- Real FastAPI backend. Do not also load mock.js. -->
  <script>
  (() => {
    const dialog = document.getElementById("projectDialog");
    if (!dialog) return;

    const tabs = [...dialog.querySelectorAll(".wizard-tab")];
    const sections = [...dialog.querySelectorAll(".wizard-section")];
    const back = document.getElementById("wizardBack");
    const next = document.getElementById("wizardNext");
    const create = document.getElementById("dialogCreate");
    const progress = document.getElementById("wizardProgress");

    let currentStep = 0;
    const stepNames = ["details", "app-type", "stack", "environment", "workspace"];

    function showStep(index) {
      currentStep = Math.max(0, Math.min(stepNames.length - 1, index));

      tabs.forEach((tab, i) => {
        const active = i === currentStep;
        tab.classList.toggle("active", active);
        tab.setAttribute("aria-selected", String(active));
      });

      sections.forEach(section => {
        section.hidden = section.dataset.section !== stepNames[currentStep];
      });

      back.disabled = currentStep === 0;
      next.hidden = currentStep === stepNames.length - 1;
      create.hidden = currentStep !== stepNames.length - 1;
      progress.textContent = `Step ${currentStep + 1} of ${stepNames.length}`;
    }

    dialog.showWizardStep = showStep;
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => showStep(index));
    });

    back.addEventListener("click", () => showStep(currentStep - 1));
    next.addEventListener("click", () => showStep(currentStep + 1));

    dialog.querySelectorAll(".environment-filter").forEach(button => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;

        dialog.querySelectorAll(".environment-filter").forEach(item => {
          item.classList.toggle("active", item === button);
        });

        dialog.querySelectorAll(".environment-item").forEach(card => {
          card.hidden = filter !== "all" && card.dataset.status !== filter;
        });
      });
    });

    const checkButton = document.getElementById("checkEnvironment");
    checkButton?.addEventListener("click", () => {
      document.getElementById("environmentStatus").textContent =
        "Prototype only. Local environment detection is not connected yet.";
    });

    dialog.querySelectorAll("[data-env-action]").forEach(button => {
      button.addEventListener("click", () => {
        document.getElementById("environmentStatus").textContent =
          "Prototype only. Installation plans and confirmation will be connected to the backend later.";
      });
    });

    showStep(0);
  })();
</script>
  <script src="/static/app.js" defer></script>
