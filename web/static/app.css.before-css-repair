
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <title>DevPilot</title>

  <!-- Browser tab icon: use one favicon only -->
  <link rel="icon" type="image/png" href="/resources/robot.png">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🤖%3C/text%3E%3C/svg%3E">

  <link rel="stylesheet" href="/static/app.css">

  <script>
    try {
      const theme = localStorage.getItem("devpilot.theme");
      if (theme) {
        document.documentElement.dataset.theme = theme;
      }
    } catch (error) {
      console.warn("Theme preference is unavailable.");
    }
  </script>
</head>

<body>
  <svg
    class="svg-defs"
    xmlns="http://www.w3.org/2000/svg"
    width="0"
    height="0"
    style="position:absolute"
    aria-hidden="true"
    focusable="false"
  >
    <symbol id="i-folder" viewBox="0 0 24 24">
      <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H10l2 2h7.5A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z"/>
      <path d="M3 9h18"/>
    </symbol>

    <symbol id="i-arrowleft" viewBox="0 0 24 24">
      <path d="M19 12H5m7 7-7-7 7-7"/>
    </symbol>

    <symbol id="i-arrowright" viewBox="0 0 24 24">
      <path d="M5 12h14m-7-7 7 7-7 7"/>
    </symbol>

    <symbol id="i-minus" viewBox="0 0 24 24">
      <path d="M5 12h14"/>
    </symbol>

    <symbol id="i-maximize" viewBox="0 0 24 24">
      <path d="M8 3H3v5M16 3h5v5M21 16v5h-5M3 16v5h5"/>
    </symbol>

    <symbol id="i-plus" viewBox="0 0 24 24">
      <path d="M12 5v14M5 12h14"/>
    </symbol>

    <symbol id="i-download" viewBox="0 0 24 24">
      <path d="M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4"/>
    </symbol>

    <symbol id="i-refresh" viewBox="0 0 24 24">
      <path d="M20 7v5h-5M4 17v-5h5"/>
      <path d="M5.5 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.5-3"/>
    </symbol>

    <symbol id="i-file" viewBox="0 0 24 24">
      <path d="M6 3h8l5 5v13H6z"/>
      <path d="M14 3v6h5M9 13h6M9 17h6"/>
    </symbol>

    <symbol id="i-chat" viewBox="0 0 24 24">
      <path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 9 9 0 0 1-4-.9L4 20l1.2-3.4A7.2 7.2 0 0 1 4 12c0-4.1 3.6-7.5 8-7.5s8 2.9 8 7z"/>
    </symbol>

    <symbol id="i-trash" viewBox="0 0 24 24">
      <path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7M10 11v5m4-5v5"/>
    </symbol>

    <symbol id="i-code" viewBox="0 0 24 24">
      <path d="m8 8-4 4 4 4m8-8 4 4-4 4m-3-11-2 14"/>
    </symbol>

    <symbol id="i-help" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9"/>
      <path d="M9.5 9a2.6 2.6 0 1 1 4.4 1.9c-1.3 1.1-1.9 1.5-1.9 3.1M12 17.5h.01"/>
    </symbol>

    <symbol id="i-stop" viewBox="0 0 24 24">
      <rect x="6" y="6" width="12" height="12" rx="2"/>
    </symbol>

    <symbol id="i-eye" viewBox="0 0 24 24">
      <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/>
      <circle cx="12" cy="12" r="2.5"/>
    </symbol>

    <symbol id="i-check" viewBox="0 0 24 24">
      <path d="m5 12 4 4L19 6"/>
    </symbol>

    <symbol id="i-x" viewBox="0 0 24 24">
      <path d="m6 6 12 12M18 6 6 18"/>
    </symbol>

    <symbol id="i-bot" viewBox="0 0 24 24">
      <rect x="4" y="7" width="16" height="13" rx="3"/>
      <path d="M12 3v4M8 12h.01M16 12h.01M8 16h8"/>
    </symbol>

    <symbol id="i-browser" viewBox="0 0 24 24">
      <rect x="3" y="4" width="18" height="16" rx="2"/>
      <path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>
    </symbol>

    <symbol id="i-server" viewBox="0 0 24 24">
      <rect x="4" y="3" width="16" height="8" rx="2"/>
      <rect x="4" y="13" width="16" height="8" rx="2"/>
      <path d="M8 7h.01M8 17h.01M12 7h5M12 17h5"/>
    </symbol>

    <symbol id="i-monitor" viewBox="0 0 24 24">
      <rect x="3" y="4" width="18" height="13" rx="2"/>
      <path d="M12 17v4m-4 0h8"/>
    </symbol>

    <symbol id="i-mobile" viewBox="0 0 24 24">
      <rect x="6" y="2" width="12" height="20" rx="2"/>
      <path d="M10 5h4m-2 13h.01"/>
    </symbol>

    <symbol id="i-terminal" viewBox="0 0 24 24">
      <rect x="3" y="4" width="18" height="16" rx="2"/>
      <path d="m7 9 3 3-3 3m6 0h4"/>
    </symbol>

    <symbol id="i-sparkles" viewBox="0 0 24 24">
      <path d="m12 3 1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3z"/>
      <path d="m19 14 1.1 2.4L22 17l-1.9.7L19 20l-1.1-2.3L16 17l1.9-.6L19 14z"/>
    </symbol>
    <symbol id="i-clip" viewBox="0 0 24 24">
      <path d="m8 12 7-7a4 4 0 0 1 6 6l-9 9a6 6 0 0 1-9-9l9-9"/>
    </symbol>
  </svg>

  <main class="shell">
    <div id="banner" class="banner" role="alert" hidden></div>

    <section id="approvalPanel" class="approval-panel" hidden aria-labelledby="approvalTitle">
      <h2 id="approvalTitle">Approval required</h2>
      <p>DevPilot is waiting for your decision before executing an action.</p>
      <div id="approvalRequests" aria-live="polite"></div>
      <p id="approvalStatus" class="chat-status" role="status"></p>
    </section>


    <div class="work-area">
      <nav class="dock" id="dock" hidden aria-label="Minimized panels"></nav>

      <div class="workspace horizontal" id="workspace">

        <!-- Explorer -->
        <section class="card pane" id="projectPanel" data-pane="explorer">
          <header class="pane-head" draggable="true" title="Drag to move this panel">
            <span class="pane-title">
              <svg class="icon" aria-hidden="true"><use href="#i-folder"></use></svg>
              <span class="pane-name">Explorer</span>
            </span>

            <span class="pane-tools">
              <button class="tool" data-act="earlier" type="button" aria-label="Move earlier">
                <svg class="icon" aria-hidden="true"><use href="#i-arrowleft"></use></svg>
              </button>
              <button class="tool" data-act="later" type="button" aria-label="Move later">
                <svg class="icon" aria-hidden="true"><use href="#i-arrowright"></use></svg>
              </button>
              <button class="tool" data-act="minimize" type="button" aria-label="Minimize Explorer">
                <svg class="icon" aria-hidden="true"><use href="#i-minus"></use></svg>
              </button>
              <button class="tool" data-act="maximize" type="button" aria-label="Maximize Explorer">
                <svg class="icon" aria-hidden="true"><use href="#i-maximize"></use></svg>
              </button>
            </span>
          </header>

          <div class="pane-body">
            <div class="panel-head">
              <h2>
                <svg class="icon" aria-hidden="true"><use href="#i-folder"></use></svg>
                Projects
              </h2>

              <div class="actions">
                <button id="newProject" class="secondary" type="button">
                  <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>
                  New
                </button>
                <button id="importProject" class="secondary" type="button">
                  <svg class="icon" aria-hidden="true"><use href="#i-download"></use></svg>
                  Import
                </button>
                <button id="refreshProjects" class="secondary icon-only" type="button" aria-label="Refresh projects">
                  <svg class="icon" aria-hidden="true"><use href="#i-refresh"></use></svg>
                </button>
              </div>
            </div>

            <ul id="projectList" class="plist"></ul>
            <p id="listStatus" class="muted" role="status" aria-live="polite"></p>

            <div id="treeBlock" hidden>
              <div class="panel-head">
                <h2>
                  <svg class="icon" aria-hidden="true"><use href="#i-file"></use></svg>
                  <span id="treeTitle">Files</span>
                </h2>
                <button id="refreshTree" class="secondary icon-only" type="button" aria-label="Refresh files">
                  <svg class="icon" aria-hidden="true"><use href="#i-refresh"></use></svg>
                </button>
              </div>

              <p id="treeStatus" class="muted" role="status" aria-live="polite"></p>
              <ul id="treeList" class="tree"></ul>
            </div>
          </div>
        </section>

        <div class="splitter" data-split="0" role="separator" tabindex="0"
             aria-label="Resize Explorer and Assistant"
             title="Drag to resize. Double-click to reset."></div>

        <!-- Project AI -->
        <section class="card pane" id="chatCard" data-pane="assistant">
          <header class="pane-head" draggable="true" title="Drag to move this panel">
            <span class="pane-title">
              <svg class="icon" aria-hidden="true"><use href="#i-chat"></use></svg>
              <span class="pane-name">Assistant</span>
            </span>

            <span class="pane-tools">
              <button class="tool" data-act="earlier" type="button" aria-label="Move earlier">
                <svg class="icon" aria-hidden="true"><use href="#i-arrowleft"></use></svg>
              </button>
              <button class="tool" data-act="later" type="button" aria-label="Move later">
                <svg class="icon" aria-hidden="true"><use href="#i-arrowright"></use></svg>
              </button>
              <button class="tool" data-act="minimize" type="button" aria-label="Minimize Assistant">
                <svg class="icon" aria-hidden="true"><use href="#i-minus"></use></svg>
              </button>
              <button class="tool" data-act="maximize" type="button" aria-label="Maximize Assistant">
                <svg class="icon" aria-hidden="true"><use href="#i-maximize"></use></svg>
              </button>
            </span>
          </header>

          <div class="pane-body col">
            <div class="panel-head">
              <h2>
                <svg class="icon" aria-hidden="true"><use href="#i-chat"></use></svg>
                Project AI
                <span id="projectBadge" class="project-badge none">No project selected</span>
              </h2>
              <button id="clearChat" class="secondary icon-only" type="button" aria-label="Clear conversation">
                <svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg>
              </button>
            </div>

            <div class="chat-pane" id="projectPane">
              <div id="projectLog" class="chat-log" aria-live="polite">Create, import, or open a project to start.</div>

              <div class="composer">
                <textarea id="projectMessage" rows="2" aria-label="Message to Project AI"
                          placeholder="Describe the change you want to make. Enter sends, Shift+Enter adds a line."></textarea>
                <button id="sendProject" class="send" type="button" aria-label="Send message">
                  <svg class="icon" aria-hidden="true"><use href="#i-arrowright"></use></svg>
                </button>
              </div>

              <div class="tagbar" role="group" aria-label="Message tags">
                <button class="tag" id="modeChange" type="button" aria-pressed="false">
                  <svg class="icon" aria-hidden="true"><use href="#i-code"></use></svg>
                  Change code
                </button>
                <button class="tag" id="modeAsk" type="button" aria-pressed="false">
                  <svg class="icon" aria-hidden="true"><use href="#i-help"></use></svg>
                  Ask
                </button>
              </div>

              <div class="actions">
                <button id="stopTask" class="secondary" type="button" hidden>
                  <svg class="icon" aria-hidden="true"><use href="#i-stop"></use></svg>
                  Stop
                </button>
                <button id="retryTask" class="secondary" type="button" hidden>
                  <svg class="icon" aria-hidden="true"><use href="#i-refresh"></use></svg>
                  Retry
                </button>
              </div>

              <p id="projectChatStatus" class="chat-status" role="status" aria-live="polite"></p>
            </div>
          </div>
        </section>

        <div class="splitter" data-split="1" role="separator" tabindex="0"
             aria-label="Resize Assistant and Canvas"
             title="Drag to resize. Double-click to reset."></div>

        <!-- Canvas -->
        <section class="card pane" id="outputPanel" data-pane="canvas">
          <header class="pane-head" draggable="true" title="Drag to move this panel">
            <span class="pane-title">
              <svg class="icon" aria-hidden="true"><use href="#i-eye"></use></svg>
              <span class="pane-name">Canvas</span>
            </span>

            <span class="pane-tools">
              <button class="tool" data-act="earlier" type="button" aria-label="Move earlier">
                <svg class="icon" aria-hidden="true"><use href="#i-arrowleft"></use></svg>
              </button>
              <button class="tool" data-act="later" type="button" aria-label="Move later">
                <svg class="icon" aria-hidden="true"><use href="#i-arrowright"></use></svg>
              </button>
              <button class="tool" data-act="minimize" type="button" aria-label="Minimize Canvas">
                <svg class="icon" aria-hidden="true"><use href="#i-minus"></use></svg>
              </button>
              <button class="tool" data-act="maximize" type="button" aria-label="Maximize Canvas">
                <svg class="icon" aria-hidden="true"><use href="#i-maximize"></use></svg>
              </button>
            </span>
          </header>

          <div class="pane-body col">
            <div class="out-head">
              <div class="seg" id="viewTabs" role="tablist" aria-label="Canvas views"></div>
              <span id="taskMeta"></span>
            </div>

            <div class="review" id="reviewBar" hidden>
              <strong id="reviewSummary"></strong>
              <button id="acceptChanges" type="button">
                <svg class="icon" aria-hidden="true"><use href="#i-check"></use></svg>
                Accept
              </button>
              <button id="rejectChanges" class="secondary" type="button">
                <svg class="icon" aria-hidden="true"><use href="#i-x"></use></svg>
                Reject
              </button>
              <span id="changesStatus" class="muted" role="status" aria-live="polite"></span>
            </div>

            <div class="out-body">
              <div class="view" data-view="preview">
                <p id="previewTitle" class="muted preview-title"></p>
                <p id="previewEmpty" class="empty">Nothing to preview yet. Build something, or click an HTML file in the project files.</p>
                <iframe id="previewFrame" sandbox="allow-scripts" title="Preview" hidden></iframe>
              </div>

              <div class="view" data-view="story_map" hidden>
                <p id="storyEmpty" class="empty">No story map yet.</p>
                <p id="storySummary" class="muted story-summary"></p>
                <div id="storyMap" class="storymap"></div>
              </div>

              <div class="view" data-view="class_diagram" hidden>
                <p class="empty">Class diagrams are coming soon.</p>
              </div>

              <div class="view" data-view="changes" hidden>
                <p id="changesEmpty" class="empty">No changes to review.</p>
                <pre id="diff"></pre>
              </div>

              <div class="view" data-view="steps" hidden>
                <p id="status" class="muted">Waiting for a project task.</p>
                <ol id="steps"></ol>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- Agent Core -->
    <aside class="core-panel card" id="corePanel" hidden aria-label="Agent Core">
      <header class="core-head">
        <span class="pane-title">
          <svg class="icon" aria-hidden="true"><use href="#i-bot"></use></svg>
          Agent Core
        </span>

        <span class="pane-tools">
          <button id="clearCore" class="tool" type="button" aria-label="Clear Agent Core conversation">
            <svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg>
          </button>
          <button id="closeCore" class="tool" type="button" aria-label="Close Agent Core">
            <svg class="icon" aria-hidden="true"><use href="#i-x"></use></svg>
          </button>
        </span>
      </header>

      <div class="chat-pane core-body">
        <div id="agentCoreLog" class="chat-log" aria-live="polite">Agent Core is ready. Ask general questions, discuss and develop DevPilot itself, or attach PDFs for it to read.</div>
        <div class="chips" id="coreFiles"></div>

        <div class="composer has-attach">
          <button id="attachCore" class="attach" type="button"
                  aria-label="Attach files"
                  title="Attach PDF, TXT, MD, or DOCX files">
            <svg class="icon" aria-hidden="true"><use href="#i-clip"></use></svg>
          </button>

          <textarea id="agentCoreMessage" rows="2" aria-label="Message to Agent Core"
                    placeholder="Ask anything, discuss the design, or drop a PDF here. Enter sends, Shift+Enter adds a line."></textarea>

          <button id="sendAgentCore" class="send" type="button" aria-label="Send message">
            <svg class="icon" aria-hidden="true"><use href="#i-arrowright"></use></svg>
          </button>
        </div>

        <div class="tagbar" role="group" aria-label="Agent Core message tags">
          <button class="tag" id="coreModeChange" type="button" aria-pressed="false">
            <svg class="icon" aria-hidden="true"><use href="#i-code"></use></svg>
            Change code
          </button>
          <button class="tag" id="coreModeAsk" type="button" aria-pressed="false">
            <svg class="icon" aria-hidden="true"><use href="#i-help"></use></svg>
            Ask
          </button>
        </div>

        <input type="file" id="coreFileInput" accept=".pdf,.txt,.md,.docx" multiple hidden>
        <p id="agentCoreStatus" class="chat-status" role="status" aria-live="polite">Ready.</p>
      </div>
    </aside>

    <!-- Create/import project dialog -->
    <!-- Create/import project dialog -->
<dialog id="projectDialog" class="project-wizard" aria-labelledby="dialogTitle">
  <header class="wizard-header">
    <div>
      <p class="wizard-eyebrow">DEVPILOT · PROJECT BUILDER</p>
      <h3 id="dialogTitle">Define New Project</h3>
      <p class="muted">Plan your project, select its stack, and prepare your workspace.</p>
    </div>
    <button id="dialogClose" class="dialog-x" type="button" aria-label="Close dialog">
      <svg class="icon" aria-hidden="true"><use href="#i-x"></use></svg>
    </button>
  </header>

  <!-- Five wizard tabs -->
  <nav id="languageBlock" class="wizard-tabs" aria-label="Project setup steps">
    <button class="wizard-tab active" type="button" data-step="details" aria-selected="true">
      <svg class="icon"><use href="#i-file"></use></svg>
      <span>Details</span>
    </button>
    <button class="wizard-tab" type="button" data-step="app-type" aria-selected="false">
      <svg class="icon"><use href="#i-bot"></use></svg>
      <span>App type</span>
    </button>
    <button class="wizard-tab" type="button" data-step="stack" aria-selected="false">
      <svg class="icon"><use href="#i-code"></use></svg>
      <span>Stack</span>
    </button>
    <button class="wizard-tab" type="button" data-step="environment" aria-selected="false">
      <svg class="icon"><use href="#i-refresh"></use></svg>
      <span>Environment Setup</span>
    </button>
    <button class="wizard-tab" type="button" data-step="workspace" aria-selected="false">
      <svg class="icon"><use href="#i-folder"></use></svg>
      <span>Workspace</span>
    </button>
  </nav>

  <div class="wizard-content">

    <!-- STEP 1: DETAILS -->
    <section class="wizard-section" data-section="details">
      <div class="wizard-section-heading">
        <div>
          <h4>Project details</h4>
          <p>Start with the purpose and goals of your project.</p>
        </div>
        <span class="step-number">01</span>
      </div>

      <div id="nameBlock">
        <label for="dialogNameInput">Project name</label>
        <input id="dialogNameInput" type="text"
               placeholder="e.g. Task Manager"
               autocomplete="off">
        <p id="idPreview" class="muted"></p>
      </div>

      <label for="projectSummary">Project brief</label>
      <textarea id="projectSummary" rows="5"
        placeholder="What do you want to build? Who will use it? What problem should it solve?"
        autocomplete="off"></textarea>

      <div class="wizard-tip">
        <svg class="icon"><use href="#i-help"></use></svg>
        <p>A clear brief helps DevPilot recommend an appropriate architecture and technology stack.</p>
      </div>
    </section>

    <!-- STEP 2: APP TYPE -->
    <section class="wizard-section" data-section="app-type" hidden>
      <div class="wizard-section-heading">
        <div>
          <h4>What are you building?</h4>
          <p>Choose the application type that best describes your project.</p>
        </div>
        <span class="step-number">02</span>
      </div>

      <div class="app-type-grid">
        <label class="choice-card">
          <input type="radio" name="appType" value="web" checked>
          <span class="choice-icon">⌘</span>
          <strong>Web application</strong>
          <small>Browser-based application with a user interface.</small>
        </label>

        <label class="choice-card">
          <input type="radio" name="appType" value="api">
          <span class="choice-icon">⇄</span>
          <strong>API / Backend</strong>
          <small>Services, endpoints and business logic.</small>
        </label>

        <label class="choice-card">
          <input type="radio" name="appType" value="desktop">
          <span class="choice-icon">▣</span>
          <strong>Desktop application</strong>
          <small>Software installed on a computer.</small>
        </label>

        <label class="choice-card">
          <input type="radio" name="appType" value="mobile">
          <span class="choice-icon">▯</span>
          <strong>Mobile application</strong>
          <small>Applications for Android and iOS.</small>
        </label>

        <label class="choice-card">
          <input type="radio" name="appType" value="cli">
          <span class="choice-icon">&gt;_</span>
          <strong>CLI tool</strong>
          <small>Command-line utilities and developer tools.</small>
        </label>

        <label class="choice-card">
          <input type="radio" name="appType" value="ai">
          <span class="choice-icon">✳</span>
          <strong>AI application</strong>
          <small>AI-powered products, agents and workflows.</small>
        </label>
      </div>
    </section>

    <!-- STEP 3: STACK -->
    <section class="wizard-section" data-section="stack" hidden>
      <div class="wizard-section-heading">
        <div>
          <h4>Technology stack</h4>
          <p>Choose your technologies or let AI propose a stack based on your project.</p>
        </div>
        <span class="step-number">03</span>
      </div>

      <div class="stack-source-options">
        <label class="source-option">
          <input type="radio" name="stackSource" value="ai" checked>
          <span>
            <strong>AI recommendation</strong>
            <small>Generate a stack based on your project requirements.</small>
          </span>
        </label>
        <label class="source-option">
          <input type="radio" name="stackSource" value="manual">
          <span>
            <strong>Manual selection</strong>
            <small>Define and edit your own technologies.</small>
          </span>
        </label>
      </div>

      <div class="stack-editor">
        <label for="stackInput">Selected technology stack</label>
        <textarea id="stackInput" rows="2"
          placeholder="e.g. React, Python + FastAPI, PostgreSQL"></textarea>
        <button id="stackSuggest" class="secondary" type="button">
          <svg class="icon"><use href="#i-refresh"></use></svg>
          Recommend stack
        </button>
        <p id="stackCheck" class="muted" role="status" hidden></p>
