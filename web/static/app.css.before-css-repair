        </article>

        <article class="environment-item" data-status="missing">
          <div class="environment-item-head">
            <div class="technology-mark">DB</div>
            <div class="technology-info">
              <strong>PostgreSQL</strong>
              <small>Database</small>
            </div>
            <span class="status-pill missing">Not installed</span>
          </div>
          <div class="version-grid">
            <div><small>Installed version</small><strong>Not found</strong></div>
            <div><small>Target version</small><strong>16</strong></div>
          </div>
          <details class="environment-details">
            <summary>Version and installation details</summary>
