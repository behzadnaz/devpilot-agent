    def test_shared_ai_api_routes_request_to_requested_capability(self):
        class FakeAICapabilities:
            def __init__(self):
                self.calls = []

            def execute(self, capability, inputs, context=None):
                self.calls.append(
                    {
                        "capability": capability,
                        "inputs": inputs,
                        "context": context,
                    }
                )
                return {
                        "architecture": {
                        "frontend": "React",
                        "backend": "FastAPI",
                        "database": "PostgreSQL",
                        "testing": "pytest",
                        "security": "JWT authentication",
                        "deployment": "Docker",
                        "scaling": "Horizontal scaling",
                        "reason": (
                            "Suitable for the described application."
                        ),
                    }
                }

        capabilities = FakeAICapabilities()
        client = TestClient(
            create_app(ai_capabilities=capabilities)
        )

        response = client.post(
            "/ai/request",
            json={
                "capability": "stack-recommendations",
                "input": {
                    "description": "Build an online bookstore"
                },
            },
        )

        assert response.status_code == 200
        assert response.json() == {
            "result": {
                "architecture": {
                    "frontend": "React",
                    "backend": "FastAPI",
                    "database": "PostgreSQL",
                    "testing": "pytest",
                    "security": "JWT authentication",
                    "deployment": "Docker",
                    "scaling": "Horizontal scaling",
                    "reason": (
                        "Suitable for the described application."
                    ),
                }
            }
        }

        assert capabilities.calls == [
            {
                "capability": "stack-recommendations",
                "inputs": {
                    "description": "Build an online bookstore"
                },
                "context": None,
            }
        ]

