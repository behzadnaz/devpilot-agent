    def test_stack_advice_uses_limited_generation_options(self, monkeypatch):
        class FakeLLM:
            def __init__(self):
                self.ask_kwargs = None

            def ask(self, prompt, **kwargs):
                self.ask_kwargs = kwargs
                return """
                               {
                                   "frontend": "React",
                                   "backend": "FastAPI",
                                   "database": "PostgreSQL",
                                   "testing": "pytest",
                                   "security": "OAuth2",
                                   "deployment": "Docker",
                                   "scaling": "Horizontal scaling",
                                   "reason": "Simple architecture for the bookstore."
                               }
                               """

        fake_llm = FakeLLM()

        monkeypatch.setattr(
            web_app_module,
            "load_model_settings",
            lambda: object(),
        )
        monkeypatch.setattr(
            web_app_module,
            "create_llm_client",
            lambda settings: fake_llm,
        )

        web_app_module.generate_stack_advice(
            "Build a simple bookstore"
        )

        assert fake_llm.ask_kwargs["options"]["num_predict"] == 1024
        assert fake_llm.ask_kwargs["think"] is False


