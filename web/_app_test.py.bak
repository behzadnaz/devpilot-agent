                {
                    "id": "my-project",
                    "workflow": "planning",
                    "summary": "",
                    "stack": "",
                    "app_type": "web",
                    "frontend_stack": "",
                    "backend_stack": "",
                    "database_stack": "",
                    "testing_stack": "",
                    "security_stack": "",
                    "deployment_stack": "",
                    "scaling_stack": "",
                },
            ]
